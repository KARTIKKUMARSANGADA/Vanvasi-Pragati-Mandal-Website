# Security
SECRET_KEY=your_random_super_secure_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_service_role_key_here

# Database (Optional for direct DB access)
DATABASE_URL=postgresql://user:pass@host:port/dbname

# Admin Initial Credentials
ADMIN_USERNAME=admin@vanvasipragati.org
ADMIN_PASSWORD=your_secure_password

# Email Notification Settings (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
ADMIN_EMAIL=your_receiving_email@gmail.com
